---
import Base from '../layouts/Base.astro';
import Breadcrumbs from './Breadcrumbs.astro';
interface Props { title: string; h1: string; description: string; html: string }
const { title, h1, description, html } = Astro.props;
const crumbs = [{ name: 'Home', href: '/' }, { name: h1, href: Astro.url.pathname }];
---
<Base title={title} description={description} noindex>
  <section class="py-12">
    <div class="container-x max-w-3xl">
      <Breadcrumbs crumbs={crumbs} />
      <h1 class="mt-4 text-3xl font-semibold tracking-tight text-ink sm:text-4xl">{h1}</h1>
      <div class="prose-x mt-8" set:html={html} />
    </div>
  </section>
</Base>
