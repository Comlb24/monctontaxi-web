---
import Logo from './Logo.astro';
import { business, tel, sms, mailto, addressOneLine, FARE_CALCULATOR_URL } from '../data/business';
import { services } from '../data/services';
import { areas } from '../data/areas';
import { legalNav } from '../data/nav';
import { longDistanceRoutes } from '../data/routes';
import { frNav, langOf, translations } from '../data/i18n';
const fr = langOf(Astro.url.pathname) === 'fr';
// On French pages, link to the French version where one exists; the rest stay English.
const href = (p: string) => (fr && translations[p]) || p;
const serviceLinks = fr
  ? [...frNav.slice(0, 2), { label: 'Chauffeur et événements', href: '/chauffeur-service' }, { label: 'Comptes d’entreprise', href: '/corporate-account' }, { label: 'Livraison de colis', href: '/package-delivery' }, { label: 'Tarifs hors ville', href: '/out-of-town-rates' }]
  : [...services.map((s) => ({ label: s.name, href: `/${s.slug}` })), { label: 'Out of Town Rates', href: '/out-of-town-rates' }];
const companyLinks = fr
  ? [{ label: 'À propos', href: '/about' }, { label: 'Nous joindre', href: '/contact' }, { label: 'Calculateur de tarif', href: FARE_CALCULATOR_URL }, { label: 'Réserver par texto', href: sms }, { label: 'WhatsApp', href: business.whatsapp }, { label: 'Facebook', href: business.socials.facebook }, { label: 'Avis Google', href: business.socials.google }, { label: 'English site', href: '/' }]
  : [{ label: 'About', href: '/about' }, { label: 'Contact', href: '/contact' }, { label: 'Join Our Team', href: '/join-our-team' }, { label: 'Book a Ride', href: '/book-online' }, { label: 'Fare Calculator', href: FARE_CALCULATOR_URL }, { label: 'Text to Book', href: sms }, { label: 'WhatsApp', href: business.whatsapp }, { label: 'Facebook', href: business.socials.facebook }, { label: 'Google reviews', href: business.socials.google }, { label: 'Français', href: '/fr' }];
const year = new Date().getFullYear();
const link = 'text-muted transition-colors hover:text-ink';
---
<footer class="border-t border-line bg-canvas">
  <div class="container-x grid gap-12 py-16 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1fr]">
    <div>
      <a href="/" class="flex items-center gap-2.5">
        <Logo />
      </a>
      <address class="mt-5 space-y-1 text-[15px] not-italic leading-relaxed text-muted">
        <span class="block">{business.address.street}</span>
        <span class="block">{business.address.city}, {business.address.region} {business.address.postalCode}</span>
        <a href={tel} class="block pt-2 text-lg font-semibold text-ink">{business.phoneDisplay}</a>
        <a href={mailto} class={`block ${link}`}>{business.email}</a>
      </address>
      <p class="mt-4 inline-flex items-center gap-2 rounded-full border border-line bg-white px-3 py-1 text-[13px] text-muted"><span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>{business.hoursText}</p>
    </div>
    <div>
      <p class="text-[13px] font-semibold uppercase tracking-[0.14em]">Services</p>
      <ul class="mt-4 space-y-2.5 text-[15px]">
        {serviceLinks.map((l) => <li><a href={l.href} class={link}>{l.label}</a></li>)}
      </ul>
    </div>
    <div>
      <p class="text-[13px] font-semibold uppercase tracking-[0.14em]">{fr ? 'Secteurs' : 'Areas'}</p>
      <ul class="mt-4 space-y-2.5 text-[15px]">
        <li><a href={href('/')} class={link}>Moncton</a></li>
        {areas.map((a) => <li><a href={href(`/${a.slug}`)} class={link}>Taxi {a.city}</a></li>)}
        {longDistanceRoutes.map((r) => <li><a href={href(`/${r.slug}`)} class={link}>Moncton → {r.city}</a></li>)}
      </ul>
    </div>
    <div>
      <p class="text-[13px] font-semibold uppercase tracking-[0.14em]">{fr ? 'Entreprise' : 'Company'}</p>
      <ul class="mt-4 space-y-2.5 text-[15px]">
        {companyLinks.map((l) => <li><a href={l.href} class={link} rel={l.href.startsWith('http') ? 'noopener' : undefined}>{l.label}</a></li>)}
      </ul>
    </div>
  </div>
  <div class="border-t border-line">
    <div class="container-x flex flex-col gap-3 py-6 text-[13px] text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {business.name} · {addressOneLine}</p>
      <ul class="flex flex-wrap gap-5">
        {legalNav.map((l) => <li><a href={l.href} class="hover:text-ink">{l.label}</a></li>)}
      </ul>
    </div>
  </div>
</footer>
