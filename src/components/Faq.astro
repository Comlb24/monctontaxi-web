---
import type { Faq } from '../data/services';
import { langOf, ui } from '../data/i18n';
interface Props { faqs: Faq[]; heading?: string }
const t = ui[langOf(Astro.url.pathname)];
const { faqs, heading = t.faqHeading } = Astro.props;
---
<section class="section">
  <div class="container-x grid gap-12 lg:grid-cols-[1fr_1.6fr]">
    <div>
      <p class="eyebrow">{t.faqEyebrow}</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-[-0.03em] sm:text-4xl">{heading}</h2>
      <p class="mt-4 text-muted">{t.faqHelp}</p>
    </div>
    <div class="divide-y divide-line border-y border-line">
      {faqs.map((f) => (
        <details class="group py-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-[17px] font-medium">
            <h3>{f.q}</h3>
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-line text-lg transition-transform duration-200 group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="mt-3 max-w-2xl leading-relaxed text-muted">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
