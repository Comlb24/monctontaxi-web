---
import { business } from '../data/business';
interface Props { tone?: 'dark' | 'light'; class?: string }
const { tone = 'dark', class: cls = '' } = Astro.props;
---
<span class:list={['inline-flex items-center gap-3', cls]}>
  <svg class="h-9 w-9 shrink-0" viewBox="0 0 64 64" aria-hidden="true">
    <rect width="64" height="64" rx="15" fill="#0b0f19" />
    <path d="M5 41v-6.5c0-2 1.3-3.3 3.3-3.7l8.2-1.6 6.1-6.6c1-1 2.4-1.6 3.8-1.6h20.2c1.6 0 3 .8 3.9 2.1l4.3 6.3 1.8.7c1.5.6 2.4 2 2.4 3.6V39c0 1.1-.9 2-2 2h-2.8a6 6 0 0 0-12 0H21.8a6 6 0 0 0-12 0z" fill="#fff" />
    <path d="M19.6 29l4.7-5H35v5zM37 24h9.3l3.9 5H37z" fill="#0b0f19" />
    <circle cx="15.8" cy="41" r="4.4" fill="#fff" /><circle cx="48.2" cy="41" r="4.4" fill="#fff" />
    <circle cx="15.8" cy="41" r="1.6" fill="#0b0f19" /><circle cx="48.2" cy="41" r="1.6" fill="#0b0f19" />
    <rect x="8" y="50" width="48" height="2" rx="1" fill="#c9a45c" />
  </svg>
  <span class="flex flex-col leading-none">
    <span class:list={['whitespace-nowrap text-[17px] font-semibold tracking-tight', tone === 'light' ? 'text-white' : 'text-ink']}>{business.name}</span>
    <span class="mt-1 whitespace-nowrap text-[9.5px] font-semibold uppercase tracking-[0.24em] text-brand-dark">Black SUV · Chauffeur</span>
  </span>
</span>
