---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { business, tel } from '../data/business';
import { mainNav } from '../data/nav';
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="sticky top-0 z-40 border-b border-line/70 bg-white/80 backdrop-blur-xl">
  <div class="container-x flex h-16 items-center justify-between gap-6">
    <a href="/" class="flex items-center gap-2.5" aria-label={`${business.name} home`}>
      <Logo />
    </a>
    <nav aria-label="Main" class="hidden xl:block">
      <ul class="flex items-center gap-1 text-[14px]">
        {mainNav.map((l) => (
          <li>
            <a href={l.href} aria-current={current === l.href ? 'page' : undefined}
              class:list={['whitespace-nowrap rounded-full px-3 py-1.5 transition-colors', current === l.href ? 'bg-canvas text-ink' : 'text-muted hover:text-ink']}>{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="flex items-center gap-2">
      <a href={tel} class="btn-primary hidden whitespace-nowrap !px-4 !py-2 !text-sm sm:inline-flex"><Icon name="phone" class="h-4 w-4" />{business.phoneDisplay}</a>
      <details class="group relative xl:hidden">
        <summary class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-full border border-line" aria-label="Open menu"><Icon name="menu" class="h-5 w-5" /></summary>
        <nav aria-label="Mobile" class="absolute right-0 mt-3 w-72 rounded-3xl border border-line bg-white p-2 shadow-2xl shadow-black/10">
          {mainNav.map((l) => <a href={l.href} class="block rounded-2xl px-4 py-3 text-[15px] font-medium hover:bg-canvas">{l.label}</a>)}
          <a href="/book-online" class="btn-accent mt-2 w-full">Book a ride</a>
        </nav>
      </details>
    </div>
  </div>
</header>
