---
import Base from '../layouts/Base.astro';
import { business, tel } from '../data/business';
---
<Base title="Page Not Found | Taxi Moncton" description="The page you are looking for does not exist." noindex>
  <section class="py-24">
    <div class="container-x max-w-2xl text-center">
      <h1 class="text-4xl font-semibold tracking-tight text-ink">This page took a wrong turn</h1>
      <p class="mt-4 text-lg text-muted">Head back to the <a href="/" class="underline">home page</a>, or call dispatch at <a href={tel} class="font-semibold underline">{business.phoneDisplay}</a>.</p>
    </div>
  </section>
</Base>
