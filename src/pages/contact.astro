---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { business, tel, sms, mailto, addressOneLine } from '../data/business';
import { breadcrumbSchema } from '../data/schema';
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Contact', href: '/contact' }];
const methods = [
  { icon: 'phone', label: 'Call', value: business.phoneDisplay, href: tel },
  { icon: 'chat', label: 'Text', value: business.phoneDisplay, href: sms },
  { icon: 'chat', label: 'WhatsApp', value: 'Message us', href: business.whatsapp },
  { icon: 'mail', label: 'Email', value: business.email, href: mailto },
];
---
<Base
  title="Contact Taxi Moncton – Call or Text (506) 797-0087"
  description="Contact Taxi Moncton Long Distance at 165 Main St, Moncton, NB E1C 2A1. Call or text (506) 797-0087, WhatsApp or email info@monctontaxi.com. Open 24/7."
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero h1="Contact Taxi Moncton" lead="Dispatch is open 24 hours a day, 7 days a week. The fastest way to book is to call or text." crumbs={crumbs} />
  <section class="py-14">
    <div class="container-x grid gap-10 lg:grid-cols-2">
      <ul class="grid gap-4 sm:grid-cols-2">
        {methods.map((m) => (
          <li>
            <a href={m.href} class="flex h-full flex-col rounded-3xl border border-line p-6 hover:-translate-y-0.5 hover:shadow-[0_20px_50px_-24px_rgba(11,15,25,0.25)] transition-all" rel={m.href.startsWith('http') ? 'noopener' : undefined}>
              <Icon name={m.icon} />
              <span class="mt-3 text-sm font-semibold uppercase tracking-wide text-muted">{m.label}</span>
              <span class="text-lg font-bold break-all text-ink">{m.value}</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="rounded-3xl bg-canvas p-8 ring-1 ring-line">
        <h2 class="text-2xl font-bold text-ink">Our location</h2>
        <address class="mt-3 text-lg not-italic leading-relaxed text-muted">
          {business.name}<br />{business.address.street}<br />{business.address.city}, {business.address.region} {business.address.postalCode}<br />Canada
        </address>
        <p class="mt-4 text-muted"><strong>Hours:</strong> {business.hoursText}</p>
        <a href={business.mapsUrl} class="btn-dark mt-6" rel="noopener"><Icon name="pin" class="h-5 w-5" />Get directions</a>
        <p class="mt-6 text-sm text-muted">{addressOneLine}</p>
      </div>
    </div>
  </section>
</Base>
